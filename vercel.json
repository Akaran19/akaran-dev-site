{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "credit-risk-app/api/test.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/credit-risk",
      "dest": "/credit-risk-app/api/index.py"
    },
    {
      "src": "/credit-risk/(.*)",
      "dest": "/credit-risk-app/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}