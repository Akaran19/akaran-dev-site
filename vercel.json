{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/credit-risk.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/credit-risk",
      "dest": "/api/credit-risk.py"
    },
    {
      "src": "/credit-risk/(.*)",
      "dest": "/api/credit-risk.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}